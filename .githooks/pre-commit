#!/usr/bin/env bash
# ============================================================
# git pre-commit 钩子（由 ./sb.sh setup-hooks 启用：git config core.hooksPath .githooks；不依赖 husky）
#
# 每次 git commit 前自动执行，任一失败即中断提交：
#   1. pnpm lint   类型检查（tsc / vue-tsc）+ prisma schema 校验 + ESLint
#   2. pnpm test   后端单元测试 + 前端单元测试
#   3. 生成文档漂移检查：改了路由/权限码却没跑 pnpm docs:gen 时提示（与 CI 同一规则）
#
# 临时跳过：SKIP_HOOKS=1 git commit -m "..."
# 手动执行：bash .githooks/pre-commit
# ============================================================
set -euo pipefail

[ "${SKIP_HOOKS:-0}" = 1 ] && { echo "==> pre-commit: SKIP_HOOKS=1，已跳过"; exit 0; }

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "非 git 仓库，跳过"; exit 0; }
cd "$ROOT"

echo "==> pre-commit: 类型检查 + ESLint（pnpm lint）"
pnpm lint

echo "==> pre-commit: 单元测试（pnpm test）"
pnpm test --silent

echo "==> pre-commit: 生成文档是否最新（pnpm docs:gen）"
pnpm --silent docs:gen >/dev/null
if ! git diff --quiet -- docs/generated; then
  echo "!! docs/generated 与源码不一致：已重新生成，请检查后 git add docs/generated 再提交"
  git diff --stat -- docs/generated
  exit 1
fi

echo "==> pre-commit: 通过"

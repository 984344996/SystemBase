generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ 用户与权限 ============

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(100)
  name      String    @db.VarChar(50)
  phone     String?   @db.VarChar(20)
  email     String?   @db.VarChar(100)
  status    String    @default("ENABLED") @db.VarChar(20) // ENABLED / DISABLED
  remark    String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // 软删除

  // ---- 安全策略 ----
  // 管理员重置密码后由系统置 true，登录后必须先改密（PASSWORD_* / 强制改密策略）
  mustChangePassword Boolean   @default(false)
  // 密码最后一次修改时间，用于 PASSWORD_EXPIRE_DAYS 过期判定（为空视为从未改过）
  pwdUpdatedAt       DateTime?

  roles         UserRole[]
  refreshTokens RefreshToken[]
}

model Role {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(50) // 如 SUPER_ADMIN
  name      String    @db.VarChar(50)
  status    String    @default("ENABLED") @db.VarChar(20)
  remark    String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users UserRole[]
  menus RoleMenu[]
}

model UserRole {
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// 菜单/权限点：type = DIRECTORY(目录) | MENU(页面) | BUTTON(按钮)
model Menu {
  id         Int       @id @default(autoincrement())
  parentId   Int?      @default(0)
  name       String    @db.VarChar(50)
  type       String    @db.VarChar(20)
  path       String?   @db.VarChar(200)   // 路由路径(DIRECTORY/MENU)
  component  String?   @db.VarChar(200)   // 前端组件路径(MENU)
  permission String?   @db.VarChar(100)   // 权限码(BUTTON 或页面级)
  icon       String?   @db.VarChar(100)
  sort       Int       @default(0)
  visible    Boolean   @default(true)
  status     String    @default("ENABLED") @db.VarChar(20)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  roles RoleMenu[]

  @@index([parentId])
}

model RoleMenu {
  roleId Int
  menuId Int
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
}

// ============ 认证 ============
// 说明：登录日志 / 操作日志 / 任务执行记录均只写日志文件(LOG_DIR/app.YYYY-MM-DD.log)，不落库

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?   @db.VarChar(50)
  ua        String?   @db.VarChar(255)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ 动态定时任务 ============

model Job {
  id            Int       @id @default(autoincrement())
  name          String    @unique @db.VarChar(100)
  handlerKey    String    @db.VarChar(100) // 对应 @JobHandler('key')
  cronExpr      String    @db.VarChar(50)  // 5 段 cron: 分 时 日 月 周
  params        Json?
  status        String    @default("ENABLED") @db.VarChar(20) // ENABLED / PAUSED
  misfirePolicy String    @default("SKIP") @db.VarChar(20)    // SKIP / RUN_ONCE
  timeoutSec    Int       @default(300)
  remark        String?   @db.VarChar(255)
  prevRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([handlerKey])
}

// ============ 通用能力 ============

// 系统参数：运行时可改的配置（不必改 env 重启），带进程内缓存
model SysConfig {
  key         String   @id @db.VarChar(100)
  value       String   @db.VarChar(2000)
  type        String   @default("STRING") @db.VarChar(20) // STRING / NUMBER / BOOL / JSON
  group       String   @default("base") @db.VarChar(50)   // 分组（前端按组展示）
  label       String   @db.VarChar(100)
  builtin     Boolean  @default(false)  // 内置项：不允许删除，部分只读
  remark      String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sys_config")
}

// 数据字典：类型 + 项（下拉选项统一来源，前端缓存复用）
model Dict {
  id        Int       @id @default(autoincrement())
  code      String    @unique @db.VarChar(50)  // 字典类型编码，如 user_status
  name      String    @db.VarChar(50)
  status    String    @default("ENABLED") @db.VarChar(20)
  remark    String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items DictItem[]

  @@map("dict")
}

model DictItem {
  id       Int      @id @default(autoincrement())
  dictId   Int
  label    String   @db.VarChar(100)
  value    String   @db.VarChar(100)
  sort     Int      @default(0)
  status   String   @default("ENABLED") @db.VarChar(20)
  remark   String?  @db.VarChar(255)
  dict     Dict     @relation(fields: [dictId], references: [id], onDelete: Cascade)

  @@unique([dictId, value])
  @@index([dictId])
  @@map("dict_item")
}

// 文件管理：只保存元信息，实体存放在 UPLOAD_DIR（默认 shared/uploads）
model File {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)  // 原始文件名
  path       String   @db.VarChar(255)  // 相对存储目录的路径（按 yyyyMM 分目录）
  mime       String   @db.VarChar(100)
  size       Int
  uploaderId Int?
  createdAt  DateTime @default(now())
  deletedAt  DateTime? // 软删除（清理任务可定期物理删除）

  @@index([uploaderId])
  @@index([deletedAt])
  @@map("file")
}

// 通知公告：置顶 + 有效期 + 已读记录
model Notice {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(200)
  content    String   @db.Text
  type       String   @default("NOTICE") @db.VarChar(20) // NOTICE 公告 / MSG 消息
  top        Boolean  @default(false)
  status     String   @default("DRAFT") @db.VarChar(20)  // DRAFT 草稿 / PUBLISHED 已发布
  startAt    DateTime?
  endAt      DateTime?
  publisherId Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reads NoticeRead[]

  @@index([status])
  @@map("notice")
}

model NoticeRead {
  id       Int      @id @default(autoincrement())
  noticeId Int
  userId   Int
  readAt   DateTime @default(now())
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId])
  @@map("notice_read")
}

// ============ 分布式锁(LOCK_DRIVER=db 时使用) ============

model SysLock {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(191)
  owner     String   @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

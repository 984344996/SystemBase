# ===== SystemBase 后端镜像（多阶段构建）=====
# 构建上下文必须是仓库根目录：
#   docker build -f deploy/docker/Dockerfile.server -t systembase-server .

# ---- 阶段1：安装依赖 + 构建 ----
FROM node:20-alpine AS build
# openssl：Prisma 在 alpine(musl) 上选择引擎所需
RUN apk add --no-cache openssl && corepack enable
WORKDIR /app
# pnpm 版本由根 package.json 的 packageManager 字段锁定
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/server/package.json apps/server/
COPY packages/shared/package.json packages/shared/
# 先装依赖（锁定版本），利用 docker 层缓存
RUN pnpm install --frozen-lockfile --filter @sb/server...
COPY packages/shared packages/shared
COPY apps/server apps/server
RUN pnpm --filter @sb/shared build \
  && pnpm --filter @sb/server prisma:generate \
  && pnpm --filter @sb/server build \
  # 产出独立的生产目录：仅生产依赖 + package.json "files"(dist、prisma)
  && pnpm --filter @sb/server deploy --prod /out \
  # deploy 会重装 node_modules，需为其重新生成 Prisma Client
  && cd /out && ./node_modules/.bin/prisma generate

# ---- 阶段2：运行时 ----
FROM node:20-alpine
RUN apk add --no-cache openssl curl tzdata
WORKDIR /app
COPY --from=build /out ./
ENV NODE_ENV=production PORT=3000 TZ=Asia/Shanghai
EXPOSE 3000
# 以非 root 运行；日志目录需可写
RUN mkdir -p /app/logs && chown -R node:node /app/logs
USER node
# 启动前：执行未应用的迁移（失败则不启动服务）
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy && node dist/main.js"]

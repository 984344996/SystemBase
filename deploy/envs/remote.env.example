# ================= SystemBase 远程环境模板（所有远程环境共用这一份） =================
# 新增环境：
#   cp deploy/envs/remote.env.example deploy/envs/remote-<名字>.env   然后填写
#   环境名只能小写字母、数字、连字符（如 remote-pre / remote-release / remote-test），
#   文件建好后即可用统一入口操作，脚本按文件名自动识别环境：
#     ./sb.sh remote-<名字> deploy | init | status | logs | rollback | restart | ssh ...
#
# 文件分两段：
#   1) 部署段（SSH_/DEPLOY_ 等）：只在本机部署脚本中使用，不会上传到服务器
#   2) 应用段（NODE_ENV 往下）：发布时上传为服务器上的 .env，与 .env.production.example 字段一致

# ---------- 1) 部署目标（不会上传） ----------
# ★ 服务器 SSH 地址
SSH_HOST=YOUR_SERVER_IP
SSH_PORT=22
SSH_USER=root
# SSH 登录密码（可选：留空则要求已配置免密登录，推荐 ssh-copy-id；
# 填写后走 sshpass，需要本机安装：macOS `brew install sshpass` / Ubuntu `apt install sshpass`；Windows 仅支持免密）
SSH_PASSWORD=
# 服务器上的部署目录（同一台机器部署多个环境时，目录与 APP_NAME 必须都不同）
DEPLOY_DIR=/opt/systembase-<名字>
# PM2 应用名 / Nginx 站点标识（只能小写字母、数字、连字符）
APP_NAME=systembase-<名字>
# 服务器上保留的历史版本数（回滚用）
KEEP_RELEASES=5
# 服务器安装依赖用的 npm 镜像
NPM_REGISTRY=https://registry.npmmirror.com
# MySQL root 密码（可选：仅 init 建库/建账号时使用，属于部署段不会上传服务器；root 免密可用时留空）
DB_ROOT_PASS=

# ---------- 2) 应用运行配置（上传为服务器 .env） ----------
NODE_ENV=production
# ★ 后端监听端口（Nest 进程，Nginx 反代到 127.0.0.1:$PORT）
#   同一台机器部署多个环境时，各环境必须不同（如预发 3001、正式 3000）
PORT=3001
# ★ Nginx 监听端口：同机多环境需错开（如预发 8080、正式 8081）；用不同域名区分时可同为 80
SITE_PORT=8080
# ★ 站点域名：留空则用 _（匹配所有域名）；同机多环境建议各配域名，Nginx 按 server_name 区分
#   例：SITE_DOMAIN="pre.example.com"（多个用空格分隔）
SITE_DOMAIN=
# ★ 子路径部署（可选）：挂到已有域名的某个路径下，如 /systembase-pre
#   配置后访问地址为 https://<SITE_DOMAIN>/systembase-pre —— 路由片段会自动注入该域名的
#   server 块（复用其 HTTPS 证书），前端构建 base 与 API 前缀自动适配；留空 = 根路径部署。
#   适合与其它应用共用一台服务器/一个域名时使用（要求 SITE_DOMAIN 已在该服务器配置）
SITE_PATH=

# ★ 数据库：init 时会在服务器本机自动创建该库与账号（主机为 127.0.0.1/localhost 时）
#   使用云数据库时把主机改为内网地址，并事先在控制台建好库与账号
#   同机多环境建议库名/账号带环境后缀（如 system_base_pre），避免互相覆盖
#   密码含 @ : / # ? & 等字符时需 URL 编码（如 @ 写成 %40）
DATABASE_URL="mysql://systembase:请替换为数据库强密码@127.0.0.1:3306/system_base"

# ★ JWT 密钥：至少 16 位，建议 32 位以上随机串（可用: openssl rand -hex 32）
JWT_SECRET="请替换为随机串"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# ★ 超管初始密码：seed 创建超管账号 admin 时使用（默认 admin123）
#   只在超管账号不存在时生效（首次 init/start、fresh 重置后）；已存在的账号不会被覆盖，改这里不影响现有密码
ADMIN_INITIAL_PASSWORD=admin123

# ★ 访问地址（逗号分隔）：部署脚本以第一个地址作为访问入口提示；配置 HTTPS 后改为 https://域名
#   子路径部署时填域名即可（前端与 API 都走 https://域名/子路径）
CORS_ORIGINS="http://YOUR_SERVER_IP"

# 反向代理跳数：Nginx 单层反代为 1（决定限流与日志中 IP 的准确性）
TRUST_PROXY=1

# 分布式锁：单机 db 即可；多实例部署改 redis 并配置 REDIS_URL
LOCK_DRIVER=db
REDIS_URL="redis://127.0.0.1:6379"

# 日志（只落文件）：相对路径 logs 在服务器上指向 shared/logs，跨版本保留
LOG_DIR="logs"
LOG_KEEP_DAYS=30
LOG_LEVEL=info

BODY_LIMIT=1mb
PERMISSION_CACHE_TTL=30
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

# ================= SystemBase 本地开发环境 =================
# 复制为 local.env 后按需修改（实际文件已被 gitignore，勿提交）
# 统一入口: ./sb.sh local start（启动时自动同步为 apps/server/.env，Nest 读取的是同步后的文件）

# ★ 数据库（本机 MySQL）
DATABASE_URL="mysql://root@localhost:3306/system_base"

# ★ JWT 密钥(至少 16 位随机串)
JWT_SECRET=""
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="7d"

# ★ 超管初始密码：seed 创建超管账号 admin 时使用（默认 admin123）
#   只在超管账号不存在时生效（首次 init/start、fresh 重置后）；已存在的账号不会被覆盖，改这里不影响现有密码
ADMIN_INITIAL_PASSWORD=admin123

# 后端端口
PORT=3000
# 前端开发端口（Vite；被占用时可用 SB_WEB_PORT=xxxx ./sb.sh local start 临时覆盖）
WEB_PORT=5173

# CORS 白名单(逗号分隔；开发留空=允许 localhost)
CORS_ORIGINS=""

# NODE_ENV: development | production
NODE_ENV=development

# ---- 分布式锁驱动: db | redis (默认 db，未装 Redis 无需改) ----
LOCK_DRIVER=db
REDIS_URL="redis://localhost:6379"
# Redis 键名前缀（多个环境/项目共用一个 Redis 时区分；更推荐每个环境用不同库号，如 redis://127.0.0.1:6379/1）
# REDIS_KEY_PREFIX=sb:

# ---- 日志(只落文件，不落库) ----
# 日志目录：每天一个文件 app.YYYY-MM-DD.log，所有级别/分类写同一文件，用 level/category 字段区分
LOG_DIR="logs"
# 日志保留天数(含当天；过期文件自动删除)
LOG_KEEP_DAYS=30
# 最低输出级别: debug | info | warn | error（缺省：生产 info，开发 debug）
LOG_LEVEL=info

# ---- 限流(全局 + 登录接口单独收紧) ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# 登录限流：本地开发放宽（频繁登录调试不会被挡）；远程环境请在 remote-*.env 保持 5 或更低
THROTTLE_LOGIN_LIMIT=20

# ---- 安全 ----
BODY_LIMIT=1mb

# ---- 安全加固（均可省略；默认宽松，不会把管理员锁死）----
# 密码最小长度（默认 8）
# PASSWORD_MIN_LENGTH=8
# 是否要求大小写+数字组合：on / off（默认 on）
# PASSWORD_COMPLEXITY=on
# 密码有效期天数，0 = 不过期
# PASSWORD_EXPIRE_DAYS=0
# 连续登录失败锁定：次数（0=不锁定）/ 锁定时长分钟 / 计数窗口分钟
# LOGIN_FAIL_LOCK_COUNT=5
# 同一账号（不论来自哪个 IP）累计失败几次后锁定账号，默认 LOGIN_FAIL_LOCK_COUNT×4，0 = 不按账号锁定
# LOGIN_FAIL_ACCOUNT_LOCK_COUNT=20
# LOGIN_FAIL_LOCK_MINUTES=10
# LOGIN_FAIL_WINDOW_MIN=30
# 登录验证码：off（默认）/ auto（失败多次后要求）/ on（总是要求；需服务端安装 svg-captcha）
# LOGIN_CAPTCHA=off
# IP 白名单/黑名单（逗号分隔，支持 192.168.* 前缀通配；留空=不限制）
# IP_WHITELIST=
# IP_BLACKLIST=

# ---- API 文档（on/off；未配置时生产关闭、其他环境开启）----
# SWAGGER_ENABLED=on

# ---- 性能 ----
# 登录用户角色/权限缓存秒数(进程内)；本实例变更即时失效，多实例最多延迟该秒数；0=关闭
PERMISSION_CACHE_TTL=30

# ---- 文件上传（可选）----
# 存储目录（相对后端运行目录；服务器上自动软链到 shared/uploads）
# UPLOAD_DIR=uploads
# 单个文件大小上限（字节），默认 10MB
# UPLOAD_MAX_SIZE=10485760
# 允许的 MIME 类型（逗号分隔；* = 不限，但 .exe/.html 等高危扩展名始终拒绝）
# UPLOAD_ALLOWED_MIME=

# ---- 定时任务（可选）----
# 多实例时每隔多少秒与数据库对账一次任务调度（0 = 关闭），默认 60
# JOB_RECONCILE_SECONDS=60

# ---- 前端日志上报（可选）----
# CLIENT_LOG_ENABLED=on
# 每天最多接收的前端日志字节数，默认 50MB
# CLIENT_LOG_DAILY_MAX_BYTES=52428800

# ---- 错误日志告警任务（可选）----
# 每小时 ERROR 条数超过阈值时推送（默认 50）；webhook 留空则只记日志
# LOG_ALERT_THRESHOLD=50
# LOG_ALERT_WEBHOOK=https://example.com/webhook
